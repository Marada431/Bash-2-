cat > dysk.sh << 'EOF'
#!/bin/bash

prog=85
prog_src="default"
verbose=0
verbose_src="default"
log="$HOME/dysk.log"

# plik konfiguracyjny
conf="$HOME/.config/dysk.conf"
if [ -f "$conf" ]; then
    while read -r line; do
        key=$(echo "$line" | cut -d '=' -f 1)
        value=$(echo "$line" | cut -d '=' -f 2)

        if [ "$key" = "prog" ]; then
            prog=$value
            prog_src="file"
        elif [ "$key" = "verbose" ]; then
            verbose=$value
            verbose_src="file"
        elif [ -n "$key" ]; then
            echo "Warnig : unknown key $key" >&2
        fi
    done < "$conf"
fi

# zmienne srodowiskowe
if [ -n "$DYSK_PROG" ]; then
    prog=$DYSK_PROG
    prog_src="env"
fi
if [ -n "$DYSK_VERBOSE" ]; then
    verbose=$DYSK_VERBOSE
    verbose_src="env"
fi

# opcje
show=0
while [ -n "$1" ]; do
    if [ "$1" = "-p" ]; then
        prog=$2
        prog_src="command line"
        shift
    elif [ "$1" = "-v" ]; then
        verbose=1
        verbose_src="command line"
    elif [ "$1" = "--pokaz-konfiguracje" ]; then
        show=1
    elif [ "$1" = "-h" ]; then
        echo "Used: $0 [-p PROCENT] [-v] [-h] [--pokaz-konfiguracje]"
        exit 0
    else
        echo "Used: $0 [-p PROCENT] [-v] [-h] [--pokaz-konfiguracje]"
        exit 1
    fi
    shift
done

if [ $show -eq 1 ]; then
    echo "prog=$prog ($prog_src)"
    echo "verbose=$verbose ($verbose_src)"
    exit 0
fi

resalut=0

df --output=pcent,target | tail -n +2 | tr -d '%' > /tmp/dysk.txt

while read -r proc mnt; do
    if [ "$proc" -gt "$prog" ]; then
        echo "Warnig : $mnt used $proc% (prog $prog%)" >> "$log"
        resalut=1
    elif [ "$verbose" -eq 1 ]; then
        echo "$mnt: $proc% - ok"
    fi
done < /tmp/dysk.txt

rm /tmp/dysk.txt

exit $resalut
EOF